# Server Configuration
PORT=3000
NODE_ENV=production
ORIGIN=*

# HiAnime Source URLs (optional - has defaults)
HIANIME_BASE_URL=https://hianime.dk
HIANIME_BASE_URL_V2=https://hianime.dk

# Base URL untuk API (digunakan di documentation)
BASE_URL=https://your-api-domain.vercel.app

# Redis Configuration (OPTIONAL - akan fallback ke scraping langsung jika tidak diset)
# Dapatkan dari https://upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Rate Limiting (optional)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_LIMIT=100

# Cloudflare Bypass (optional - untuk anti-bot bypass)
CF_CLEARANCE=
CF_USER_AGENT=

# Logging
ENABLE_LOGGING=false
LOG_LEVEL=INFO
